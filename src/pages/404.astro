---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { getContent } from '../lib/content';
const c = await getContent();
const co = c.settings.company ?? {};
---
<Base bodyClass="page" title="Strona nie istnieje — Soft Car Service" description="Nie znaleziono strony.">
  <div>
    <PageBanner title="404 — strona nie istnieje" />
    <div class="center" data-center="1">
      <div id="content" class="col-xs-12">
        <article class="item-page">
          <div class="row"><div class="col-md-12">
            <h1>Nie znaleźliśmy tej strony</h1>
            <p>Adres jest nieprawidłowy albo strona została przeniesiona. Skorzystaj z menu powyżej
              lub wróć na <a href="/">stronę główną</a>.</p>
            <p>Potrzebujesz pomocy? Zadzwoń: <a href={co.phone_href}>{co.phone}</a>
              lub napisz: <a href={`mailto:${co.email}`}>{co.email}</a>.</p>
            <p><a class="btn btn-default btn-default-size" href="/">Strona główna</a></p>
          </div></div>
        </article>
      </div>
      <div class="clearfix"></div>
    </div>
  </div>
</Base>
