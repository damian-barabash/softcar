---
import PageBanner from './PageBanner.astro';
import InfoBoxes from './home/InfoBoxes.astro';
import Gallery from './Gallery.astro';
interface Props { title: string; banner?: string | null; body: string; parent?: { label: string; href: string } | null; pageId?: number }
const { title, banner, body, parent, pageId } = Astro.props;
const [beforeGallery, afterGallery] = body.split('<!--GALERIA-->');
---
<div>
  <div id="system-message-container"></div>
  <PageBanner title={title} banner={banner} parent={parent} />
  <div class="center" data-center="1">
    <div id="content" class="col-xs-12">
      <article class="item-page" data-content="1">
        <div data-sc={pageId ? `pages:${pageId}:body_html#0:html` : undefined} data-sc-label="Treść strony" set:html={beforeGallery} />
        {afterGallery !== undefined && <Gallery />}
        {afterGallery !== undefined && (
          <div data-sc={pageId ? `pages:${pageId}:body_html#1:html` : undefined} data-sc-label="Treść pod galerią" set:html={afterGallery} />
        )}
        <slot name="article" />
      </article>
    </div>
    <div class="clearfix"></div>
  </div>
  <div class="center">
    <InfoBoxes place="pages" />
  </div>
  <slot />
  <div class="clearfix"></div>
</div>
