---
import { getContent } from '../../lib/content';
const c = await getContent();
const head = c.settings.home_usp ?? {};
---
<div class="block198 ">
  <div class="col-xs-12">
    <div class="inner row">
      <div class="section198 display-section" data-position="usp-glowna-sekcja">
        <div class="clearfix"></div>
        <div class="block605 " id="section-usp">
          <div class="col-xs-12">
            <div class="inner row animated  bounceInUp">
              <div class="center">
                <div class="section605 section-usp-g" data-position="usp-g-sekcja">
                  <div class="clearfix"></div>
                  <div class="center">
                    <div class="block604 ">
                      <div class="col-xs-12 col-md-3">
                        <div class="inner">
                          <div class="row"><div class="col-md-12">
                            {head.kicker && <p class="mininaglowek" data-sc="settings:home_usp:kicker:text" data-sc-label="Wyróżniki — nadtytuł">{head.kicker}</p>}
                            <hr class="hr-zmienny-2" />
                          </div></div>
                        </div>
                        <div class="clearfix"></div>
                      </div>
                    </div>
                  </div>
                  <div class="center">
                    <div class="block603 usp-img-background">
                      <div class="col-xs-12 col-md-8 col-md-offset-1">
                        <div class="inner text-center">
                          <div class="row">
                            {c.usp.map((u, i) => (
                              <div class={`col-md-3 col-sm-6 ${i === 0 ? 'margin-bottom-sm margin-bottom-xs' : 'margin-bottom-xs margin-bottom-sm'}`}>
                                <p><img src={u.icon} alt={u.icon_alt ?? u.label} width="50" height="50" loading="lazy" data-sc={`usp_items:${u.id}:icon:image`} data-sc-label="Wyróżnik — ikona" /></p>
                                <p class="text-stylekmlrhjv6" data-sc={`usp_items:${u.id}:label:text`} data-sc-label="Wyróżnik — podpis" set:html={u.label} />
                              </div>
                            ))}
                          </div>
                        </div>
                        <div class="clearfix"></div>
                      </div>
                    </div>
                  </div>
                  <div class="clearfix"></div>
                </div>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        </div>
        <div class="clearfix"></div>
      </div>
    </div>
    <div class="clearfix"></div>
  </div>
</div>
