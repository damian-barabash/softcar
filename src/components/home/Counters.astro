---
import { getContent } from '../../lib/content';
const c = await getContent();
const h = c.settings.home_counters ?? {};
---
<div class="block173 ">
  <div class="col-xs-12">
    <div class="inner row">
      <div class="section173 display-section" data-position="licznik-home-glowna-sekcja">
        <div class="clearfix"></div>
        <div class="block953 " id="section-counterhome">
          <div class="col-xs-12">
            <div class="inner row">
              <div class="center" data-center="1">
                <div class="section953 section-counterhome-d" data-position="licznik-d-home-sekcja">
                  <div class="clearfix"></div>
                  <div class="center">
                    <div class="block952 ">
                      <div class="col-xs-12">
                        <div class="inner row text-center">
                          <div class="center">
                            <div class="row"><div class="col-md-4 col-md-offset-4">
                              {h.kicker && <p class="mininaglowek" data-sc="settings:home_counters:kicker:text" data-sc-label="Liczniki — nadtytuł">{h.kicker}</p>}
                              <hr class="hr-zmienny-2" />
                            </div></div>
                            {h.heading && <div class="row"><div class="col-md-12"><h2 data-sc="settings:home_counters:heading:text" data-sc-label="Liczniki — nagłówek" set:html={h.heading} /></div></div>}
                            {h.body_html && <div class="row"><div class="col-md-12"><div data-sc="settings:home_counters:body_html:html" data-sc-label="Liczniki — opis" set:html={h.body_html} /></div></div>}
                            <div class="clearfix"></div>
                          </div>
                        </div>
                        <div class="clearfix"></div>
                      </div>
                    </div>
                  </div>
                  {c.counters.map((cn) => (
                    <div class="center">
                      <div class={`block${cn.css_block} `}>
                        <div class="col-xs-12 col-sm-4">
                          <div class="inner row text-center">
                            <div class="counter ">
                              <div class="title">
                                <div class="ist-ccount">
                                  <span class="number number_style" data-counter={cn.value} data-sc={`counters:${cn.id}:value:number`} data-sc-label="Licznik — wartość">0</span>{cn.suffix}
                                </div>
                                <div class="row"><div class="col-md-12"><p data-sc={`counters:${cn.id}:label:text`} data-sc-label="Licznik — podpis">{cn.label}</p></div></div>
                              </div>
                            </div>
                          </div>
                          <div class="clearfix"></div>
                        </div>
                      </div>
                    </div>
                  ))}
                  <div class="clearfix"></div>
                </div>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        </div>
        <div class="clearfix"></div>
      </div>
    </div>
    <div class="clearfix"></div>
  </div>
</div>
