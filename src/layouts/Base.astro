---
import '../styles/legacy.css';
import '../styles/legacy-desktop.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content';
import { GTM_ID } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, bodyClass = '', canonical, ogImage } = Astro.props;
const c = await getContent();
const seo = c.settings.seo ?? {};
const brand = c.settings.branding ?? {};
const company = c.settings.company ?? {};
const pageTitle = title ?? seo.title;
const pageDesc = description ?? seo.description;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const og = ogImage ?? brand.og_image ?? '/images/design/logo-soft-car-service.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: company.name,
  image: new URL(og, Astro.site).href,
  telephone: company.phone,
  email: company.email,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.zip,
    addressLocality: company.city,
    addressCountry: 'PL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: company.map_lat, longitude: company.map_lng },
  openingHours: company.hours,
};
---

<!DOCTYPE html>
<html lang="pl-PL" itemscope itemtype="https://schema.org/WebPage">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Google Tag Manager — jak najwyzej w <head>, zeby zdazyl przed reszta strony -->
    {GTM_ID && (
      <script
        is:inline
        set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`}
      />
    )}
    <!-- koniec Google Tag Manager -->

    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    <link rel="canonical" href={url} />
    <link rel="icon" href={brand.favicon ?? '/images/design/favicon.ico'} type="image/vnd.microsoft.icon" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.site_name} />
    <meta property="og:locale" content={seo.locale ?? 'pl_PL'} />
    <meta property="og:title" content={pageTitle} />
    {pageDesc && <meta property="og:description" content={pageDesc} />}
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(og, Astro.site).href} />
    <link rel="preload" href="/fonts/poppins-regular-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fahkwang-regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
    <script is:inline>
      document.documentElement.className += ' js';
      (function () {
        function bp() {
          var w = window.innerWidth;
          return w >= 1440 ? 'body-xl' : w >= 1200 ? 'body-lg' : w >= 992 ? 'body-md' : w >= 768 ? 'body-sm' : 'body-xs';
        }
        function set() {
          var b = document.body;
          if (!b) return;
          b.className = b.className.replace(/\bbody-(xs|sm|md|lg|xl)\b/g, '').trim() + ' ' + bp();
        }
        document.addEventListener('DOMContentLoaded', set);
        window.addEventListener('resize', set);
      })();
    </script>
  </head>
  <body class={`${bodyClass} light lang-pl`.trim()}>
    <!-- Google Tag Manager (noscript) — musi byc zaraz po <body> -->
    {GTM_ID && (
      <noscript
        set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}
      />
    )}
    <!-- koniec Google Tag Manager (noscript) -->

    <div id="wrapper">
      <div id="container">
        <Header />
        <div id="main">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
    <script src="/js/site.js" is:inline defer></script>

    <!-- Wizualny edytor: kod pobiera sie tylko wtedy, gdy w przegladarce jest sesja redakcji.
         Zwykly odwiedzajacy nie sciaga ani bajta tej paczki. -->
    <script>
      const editable = (() => {
        try {
          return !!localStorage.getItem('softcar-admin') || new URLSearchParams(location.search).has('edit');
        } catch {
          return false;
        }
      })();
      if (editable) {
        import('../editor/app.js').then((m) => m.init()).catch(() => {});
      }
    </script>
  </body>
</html>
